{
  "name": "pushup-league",
  "version": "1.0.0",
  "private": true,
  "description": "PushUp League - a social fitness app where friends compete by doing push-ups every day.",
  "scripts": {
    "setup": "node scripts/setup-assets.mjs",
    "predev": "node scripts/setup-assets.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/setup-assets.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-detector.mjs && node scripts/test-social.mjs",
    "test:detector": "node scripts/test-detector.mjs",
    "test:social": "node scripts/test-social.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "db:reset": "node scripts/reset-db.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "next": "^15.5.27",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "8.5.23"
  }
}
